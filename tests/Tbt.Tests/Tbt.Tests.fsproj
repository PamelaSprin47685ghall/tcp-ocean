<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Test code does not need the F# optimiser. Session and handshake
         tests live in Tbt.Tests.Session; see
         docs/cases/test-build-latency-2026-11-18.md. -->
    <Optimize>false</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Vectors.fs" />
    <Compile Include="ReadySetTests.fs" />
    <Compile Include="CodecTests.fs" />
    <Compile Include="WindowCodecTests.fs" />
    <Compile Include="WindowBridgeTests.fs" />
    <Compile Include="WindowRxBackendTests.fs" />
    <Compile Include="WindowCustodyTests.fs" />
    <Compile Include="WindowGrantTests.fs" />
    <Compile Include="WindowTxStoreTests.fs" />
    <Compile Include="WindowTxAdapterTests.fs" />
    <Compile Include="WindowRepairLedgerTests.fs" />
    <Compile Include="WindowRepairDispatchTests.fs" />
    <Compile Include="WindowParityDispatchTests.fs" />
    <Compile Include="WireTests.fs" />
    <Compile Include="CryptoTests.fs" />
    <Compile Include="RateGroupTests.fs" />
    <Compile Include="PathPoolTests.fs" />
    <Compile Include="PathLinkHalfOpenTests.fs" />
    <Compile Include="KernelTcpInfoTests.fs" />
    <Compile Include="WriteGateRateTests.fs" />
    <Compile Include="PathClassTests.fs" />
    <Compile Include="PollerTests.fs" />
    <Compile Include="PlatformTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../vectors/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="vectors" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tbt.Contracts/Tbt.Contracts.fsproj" />
    <ProjectReference Include="../../src/Tbt.Codec/Tbt.Codec.fsproj" />
    <ProjectReference Include="../../src/Tbt.Wire/Tbt.Wire.fsproj" />
    <ProjectReference Include="../../src/Tbt.Crypto/Tbt.Crypto.fsproj" />
    <ProjectReference Include="../../src/Tbt.Session/Tbt.Session.fsproj" />
    <ProjectReference Include="../../src/Tbt.Carrier/Tbt.Carrier.fsproj" />
  </ItemGroup>
</Project>
