<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Vectors.fs" />
    <Compile Include="CodecTests.fs" />
    <Compile Include="WireTests.fs" />
    <Compile Include="CryptoTests.fs" />
    <Compile Include="SessionTests.fs" />
    <Compile Include="TunTests.fs" />
    <Compile Include="FuzzTests.fs" />
    <Compile Include="PollerTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../vectors/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="vectors" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tbt.Contracts/Tbt.Contracts.fsproj" />
    <ProjectReference Include="../../src/Tbt.Codec/Tbt.Codec.fsproj" />
    <ProjectReference Include="../../src/Tbt.Wire/Tbt.Wire.fsproj" />
    <ProjectReference Include="../../src/Tbt.Crypto/Tbt.Crypto.fsproj" />
    <ProjectReference Include="../../src/Tbt.Session/Tbt.Session.fsproj" />
    <ProjectReference Include="../../src/Tbt.Carrier/Tbt.Carrier.fsproj" />
  </ItemGroup>
</Project>
