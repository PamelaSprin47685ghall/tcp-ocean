<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Vectors.fs" />
    <Compile Include="ReadySetTests.fs" />
    <Compile Include="CodecTests.fs" />
    <Compile Include="WireTests.fs" />
    <Compile Include="CryptoTests.fs" />
    <Compile Include="SessionTests.fs" />
    <Compile Include="HandshakeCryptoTests.fs" />
    <Compile Include="ArrivalEvidenceTests.fs" />
    <Compile Include="ArrivalShadowTests.fs" />
    <Compile Include="JoinTests.fs" />
    <Compile Include="BootstrapTests.fs" />
    <Compile Include="TunTests.fs" />
    <Compile Include="ArrivalTunTests.fs" />
    <Compile Include="ArrivalRunnerTests.fs" />
    <Compile Include="ArrivalLifecycleTests.fs" />
    <Compile Include="TunAckSchedulingTests.fs" />
    <Compile Include="RtoEnvelopeTests.fs" />
    <Compile Include="RateGroupTests.fs" />
    <Compile Include="KernelTcpInfoTests.fs" />
    <Compile Include="PaceTests.fs" />
    <Compile Include="FuzzTests.fs" />
    <Compile Include="PollerTests.fs" />
    <Compile Include="PlatformTests.fs" />
    <Compile Include="GovernorTests.fs" />
    <Compile Include="ControlTests.fs" />
    <Compile Include="CliTests.fs" />
    <Compile Include="BridgeTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../vectors/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="vectors" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../experiments/ArrivalShadowRunner/Tbt.ArrivalShadowRunner.fsproj" />
    <ProjectReference Include="../../src/Tbt.Contracts/Tbt.Contracts.fsproj" />
    <ProjectReference Include="../../src/Tbt.Codec/Tbt.Codec.fsproj" />
    <ProjectReference Include="../../src/Tbt.Wire/Tbt.Wire.fsproj" />
    <ProjectReference Include="../../src/Tbt.Crypto/Tbt.Crypto.fsproj" />
    <ProjectReference Include="../../src/Tbt.Session/Tbt.Session.fsproj" />
    <ProjectReference Include="../../src/Tbt.Carrier/Tbt.Carrier.fsproj" />
    <ProjectReference Include="../../src/Tbt.Cli/Tbt.Cli.fsproj" />
  </ItemGroup>
</Project>
